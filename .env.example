# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# Required in production (deployed hosts). Locally, falls back to "dev" if unset.
# Gates the CSV upload page (/upload.html), the photo editor (/edit-photos.html),
# and their API endpoints.
HOST_PASSWORD=dev

# Optional. If both are set, uploaded games are stored in Upstash Redis instead of
# local disk — required for uploads to survive a redeploy on platforms with ephemeral
# storage (e.g. Render's standard tier). Get these from https://console.upstash.com
# after creating a free Redis database (REST API tab).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. If set, question photos uploaded via /edit-photos.html are stored in
# Cloudinary instead of local disk — same durability reasoning as Upstash above.
# Get this from https://console.cloudinary.com — dashboard homepage shows it directly
# as the "API Environment variable" (format: cloudinary://<api_key>:<api_secret>@<cloud_name>).
CLOUDINARY_URL=
